{
  "name": "Oneirophany \u2014 Step 3 Writing & Polish",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Oneirophany \u2014 Step 3: Writing & Polish",
        "formDescription": "Generates a chapter blueprint, drafts prose, critiques and revises it, then produces a final smoothed chapter. Two human-approval gates included.",
        "formFields": {
          "values": [
            {
              "fieldName": "Project ID",
              "fieldLabel": "ProjectId",
              "placeholder": "Short project identifier, e.g. my-novel",
              "requiredField": true
            },
            {
              "fieldName": "Book Title",
              "fieldLabel": "BookTitle",
              "placeholder": "Used to name output docs",
              "requiredField": true
            },
            {
              "fieldName": "Output Folder ID",
              "fieldLabel": "OutputFolderId",
              "placeholder": "Google Drive folder ID for created docs",
              "requiredField": true
            },
            {
              "fieldName": "Chapter Number",
              "fieldLabel": "ChapterNumber",
              "placeholder": "e.g. 3",
              "requiredField": true
            },
            {
              "fieldName": "Mode",
              "fieldLabel": "Mode",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "draft"
                  },
                  {
                    "option": "outline"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldName": "Story Foundation Pack Doc ID",
              "fieldLabel": "StoryFoundationPackDocId",
              "placeholder": "Google Doc ID containing the Step 2 updated_pack JSON",
              "requiredField": true
            },
            {
              "fieldName": "Approved Outline Doc ID",
              "fieldLabel": "ApprovedOutlineDocId",
              "placeholder": "Google Doc ID with approved outline (leave blank if none)"
            },
            {
              "fieldName": "Scene Targets",
              "fieldLabel": "SceneTargets",
              "placeholder": "JSON array or comma-separated list of scene targets (optional)"
            },
            {
              "fieldName": "Focus Notes",
              "fieldLabel": "FocusNotes",
              "placeholder": "Optional notes for this chapter"
            }
          ]
        },
        "options": {}
      },
      "id": "step3-form-trigger-node",
      "name": "Start Writing Pipeline",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.4,
      "position": [
        260,
        400
      ],
      "webhookId": "oneirophany-step3-writing-pipeline"
    },
    {
      "parameters": {
        "operation": "get",
        "documentURL": "={{ $('Start Writing Pipeline').item.json['Story Foundation Pack Doc ID'] }}"
      },
      "id": "step3-load-pack-node",
      "name": "Load Pack",
      "type": "n8n-nodes-base.googleDocs",
      "typeVersion": 2,
      "position": [
        520,
        400
      ],
      "credentials": {
        "googleDocsOAuth2Api": {
          "id": "r2zT6MOWlh8t9hDn",
          "name": "Google Docs account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "step3-has-outline-cond-0",
              "leftValue": "={{ $('Start Writing Pipeline').item.json['Approved Outline Doc ID'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "step3-if-has-outline-node",
      "name": "IF: Has Approved Outline?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        400
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "documentURL": "={{ $('Start Writing Pipeline').item.json['Approved Outline Doc ID'] }}"
      },
      "id": "step3-load-outline-node",
      "name": "Load Approved Outline",
      "type": "n8n-nodes-base.googleDocs",
      "typeVersion": 2,
      "position": [
        1040,
        280
      ],
      "credentials": {
        "googleDocsOAuth2Api": {
          "id": "r2zT6MOWlh8t9hDn",
          "name": "Google Docs account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { approved_outline: $input.first().json.content || null } }];"
      },
      "id": "step3-extract-outline-node",
      "name": "Extract Outline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { approved_outline: null } }];"
      },
      "id": "step3-skip-outline-node",
      "name": "Skip Outline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        520
      ]
    },
    {
      "parameters": {
        "mode": "chooseBranch"
      },
      "id": "step3-merge-outline-paths-node",
      "name": "Merge Outline Paths",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1560,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const form = $('Start Writing Pipeline').item.json;\nconst packDoc = $('Load Pack').first().json;\nconst outlineData = $input.first().json;\n\nconst project_id = String(form['Project ID'] || '').trim();\nconst book_title = String(form['Book Title'] || '').trim();\nconst output_folder_id = String(form['Output Folder ID'] || '').trim();\nconst chapter_number = Number(form['Chapter Number']);\nconst mode = String(form['Mode'] || 'draft').trim().toLowerCase();\n\nif (!project_id) throw new Error('Project ID is required');\nif (!book_title) throw new Error('Book Title is required');\nif (!output_folder_id) throw new Error('Output Folder ID is required');\nif (!Number.isFinite(chapter_number) || chapter_number < 1)\n  throw new Error('Chapter Number must be a positive integer');\nif (!['outline', 'draft'].includes(mode))\n  throw new Error('Mode must be \"outline\" or \"draft\"');\n\nlet story_foundation_pack;\ntry {\n  story_foundation_pack = JSON.parse(packDoc.content);\n} catch (e) {\n  throw new Error('Failed to parse Story Foundation Pack from Google Doc: ' + e.message);\n}\n\nconst approved_outline = outlineData.approved_outline || null;\n\nconst scene_targets_raw = String(form['Scene Targets'] || '').trim();\nlet scene_targets = [];\nif (scene_targets_raw) {\n  try { scene_targets = JSON.parse(scene_targets_raw); }\n  catch (e) { scene_targets = scene_targets_raw.split(',').map(s => s.trim()).filter(Boolean); }\n}\n\nconst focus_notes = String(form['Focus Notes'] || '').trim();\n\nreturn [{ json: { project_id, book_title, output_folder_id, chapter_number, mode,\n                  scene_targets, focus_notes, story_foundation_pack, approved_outline,\n                  scene_cards: [] } }];"
      },
      "id": "step3-validate-intake-node",
      "name": "Validate Intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/drive/v3/files?supportsAllDrives=true",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $json.book_title }} - Ch.{{ $json.chapter_number }} Blueprint\",\n  \"mimeType\": \"application/vnd.google-apps.document\",\n  \"parents\": [\"{{ $json.output_folder_id }}\"]\n}",
        "options": {}
      },
      "id": "step3-create-blueprint-doc-node",
      "name": "Create Blueprint Doc",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2080,
        400
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "kkL7dT8eN7qtyx7E",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/drive/v3/files?supportsAllDrives=true",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $json.book_title }} - Ch.{{ $json.chapter_number }} Final Draft\",\n  \"mimeType\": \"application/vnd.google-apps.document\",\n  \"parents\": [\"{{ $json.output_folder_id }}\"]\n}",
        "options": {}
      },
      "id": "step3-create-final-draft-doc-node",
      "name": "Create Final Draft Doc",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2340,
        400
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "kkL7dT8eN7qtyx7E",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Validate Intake').first().json;\nconst blueprintDoc = $('Create Blueprint Doc').first().json;\nconst finalDraftDoc = $('Create Final Draft Doc').first().json;\nreturn [{ json: { ...prev, blueprint_doc_id: blueprintDoc.id, final_draft_doc_id: finalDraftDoc.id } }];"
      },
      "id": "step3-collect-doc-ids-node",
      "name": "Collect Output Doc IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const req = $('Collect Output Doc IDs').first().json;\nreturn [{ json: req }];"
      },
      "id": "step3-load-authority-context-node",
      "name": "Load Authority Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $('Load Authority Context').first().json;\nconst pack = data.story_foundation_pack || {};\nconst cs = pack.completeness_status || {};\n\nconst readyForOutline = !!cs.ready_for_outline;\nconst readyForDrafting = !!cs.ready_for_drafting;\nconst mode = data.mode;\n\nconst gate_pass = (mode === 'outline') ? readyForOutline : readyForDrafting;\n\nreturn [{\n  json: {\n    ...data,\n    gate_pass,\n    readiness_snapshot: {\n      mode,\n      ready_for_outline: readyForOutline,\n      ready_for_drafting: readyForDrafting,\n      blocking_issues: cs.blocking_issues || []\n    }\n  }\n}];"
      },
      "id": "step3-compute-readiness-node",
      "name": "Compute Readiness",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "step3-readiness-condition-0",
              "leftValue": "={{ $json.gate_pass }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "step3-if-readiness-node",
      "name": "IF Ready For Stage",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3380,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $('Compute Readiness').first().json;\nreturn [{ json: { success: false, halted: true, reason: 'Readiness gate failed',\n                  mode: d.mode, readiness_snapshot: d.readiness_snapshot } }];"
      },
      "id": "step3-gate-fail-output-node",
      "name": "Gate Fail Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3640,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $('Compute Readiness').first().json;\nconst pack = d.story_foundation_pack;\n\nconst compressed_context_pack = {\n  project_core:      pack.project_core || {},\n  world_foundation:  pack.world_foundation || {},\n  story_engine:      pack.story_engine || {},\n  character_system:  pack.character_system || {},\n  plot_frame:        pack.plot_frame || {},\n  ending_design:     pack.ending_design || {},\n  author_preferences: pack.author_preferences || {},\n  approved_outline:  d.approved_outline,\n  chapter_target: {\n    chapter_number: d.chapter_number,\n    scene_targets:  d.scene_targets,\n    focus_notes:    d.focus_notes\n  }\n};\n\nreturn [{ json: { ...d, compressed_context_pack } }];"
      },
      "id": "step3-build-context-pack-node",
      "name": "Build Context Pack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3640,
        540
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $('Build Context Pack').first().json;\nconst system = [\n  'You create chapter blueprints only.',\n  'Return JSON only.',\n  'Do not draft prose in this step.'\n].join('\\n');\n\nconst user = [\n  `Project: ${d.project_id}`,\n  `Chapter: ${d.chapter_number}`,\n  '',\n  'Compressed context pack:',\n  JSON.stringify(d.compressed_context_pack, null, 2),\n  '',\n  'Return blueprint JSON with keys:',\n  '- chapter_objective',\n  '- scene_sequence (array)',\n  '- continuity_requirements (array)',\n  '- pov_tense_voice'\n].join('\\n');\n\nreturn [{\n  json: {\n    ...d,\n    request_body: {\n      model: 'claude-sonnet-4-6',\n      max_tokens: 4096,\n      system,\n      messages: [{ role: 'user', content: user }]\n    }\n  }\n}];"
      },
      "id": "step3-build-blueprint-request-node",
      "name": "Build Blueprint Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3900,
        540
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($input.first().json.request_body) }}",
        "options": {}
      },
      "id": "step3-ai-blueprint-node",
      "name": "AI: Generate Blueprint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4160,
        540
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $('AI: Generate Blueprint').first().json;\nconst prev = $('Build Blueprint Request').first().json;\nconst raw = response.content && response.content[0] ? response.content[0].text : '';\nconst cleaned = raw.replace(/^```json\\s*/i, '').replace(/\\s*```$/i, '').trim();\n\nlet blueprint;\ntry {\n  blueprint = JSON.parse(cleaned);\n} catch (e) {\n  return [{ json: { parse_error: true, error_message: 'Blueprint JSON parse failed: ' + e.message, raw_response: raw } }];\n}\n\nreturn [{ json: { parse_error: false, ...prev, chapter_blueprint: blueprint } }];"
      },
      "id": "step3-parse-blueprint-node",
      "name": "Parse Blueprint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4420,
        540
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "step3-blueprint-parse-condition-0",
              "leftValue": "={{ $json.parse_error }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "step3-if-blueprint-parse-error-node",
      "name": "IF Blueprint Parse Error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        4680,
        540
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $('Parse Blueprint').first().json;\nreturn [{ json: { success: false, halted: true, reason: d.error_message, raw_response: d.raw_response || null } }];"
      },
      "id": "step3-blueprint-parse-fail-output-node",
      "name": "Blueprint Parse Fail Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4940,
        400
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentURL": "={{ $json.blueprint_doc_id }}",
        "actionsUi": {
          "actionFields": [
            {
              "action": "insert",
              "text": "=# Chapter {{ $json.chapter_number }} \u2014 Blueprint\n\nProject: {{ $json.project_id }}\nGenerated: {{ new Date().toISOString().split('T')[0] }}\n\n---\n\n```json\n{{ JSON.stringify($json.chapter_blueprint, null, 2) }}\n```\n"
            }
          ]
        }
      },
      "id": "step3-save-blueprint-node",
      "name": "Save Blueprint",
      "type": "n8n-nodes-base.googleDocs",
      "typeVersion": 2,
      "position": [
        4940,
        680
      ],
      "credentials": {
        "googleDocsOAuth2Api": {
          "id": "r2zT6MOWlh8t9hDn",
          "name": "Google Docs account"
        }
      }
    },
    {
      "parameters": {
        "amount": 0
      },
      "id": "step3-human-gate-blueprint-node",
      "name": "Human Gate: Blueprint Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        5200,
        680
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $('Parse Blueprint').first().json;\nconst resumeData = $input.first().json;\n\n// Reads approval_status and approval_notes from the wait-node resume webhook payload.\n// POST { \"approval_status\": \"approved\", \"approval_notes\": \"...\" } to the resume URL.\nconst approval_status = String(resumeData.approval_status || 'rejected').toLowerCase();\nconst approval_notes = String(resumeData.approval_notes || '');\n\nreturn [{ json: { ...d, approval_status, approval_notes } }];"
      },
      "id": "step3-capture-blueprint-decision-node",
      "name": "Capture Blueprint Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5460,
        680
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "step3-blueprint-approval-condition-0",
              "leftValue": "={{ $json.approval_status }}",
              "rightValue": "approved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "step3-if-blueprint-approved-node",
      "name": "IF Blueprint Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        5720,
        680
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $('Capture Blueprint Decision').first().json;\nreturn [{ json: { success: false, halted: true, reason: 'Blueprint rejected', approval_notes: d.approval_notes || '' } }];"
      },
      "id": "step3-blueprint-rejected-output-node",
      "name": "Blueprint Rejected Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5980,
        540
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $('Capture Blueprint Decision').first().json;\nconst system = 'Draft chapter prose from approved blueprint only. Return plain text prose.';\nconst user = [\n  `Chapter: ${d.chapter_number}`,\n  'Approved blueprint:',\n  JSON.stringify(d.chapter_blueprint, null, 2),\n  '',\n  'Constraints:',\n  '- Keep canon consistency',\n  '- Match author preferences',\n  '- Preserve required payoffs where applicable'\n].join('\\n');\n\nreturn [{\n  json: {\n    ...d,\n    request_body: {\n      model: 'claude-sonnet-4-6',\n      max_tokens: 8192,\n      system,\n      messages: [{ role: 'user', content: user }]\n    }\n  }\n}];"
      },
      "id": "step3-build-draft-request-node",
      "name": "Build Draft Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5980,
        820
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($input.first().json.request_body) }}",
        "options": {}
      },
      "id": "step3-ai-draft-node",
      "name": "AI: Draft Prose",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        6240,
        820
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $('Build Draft Request').first().json;\nconst r = $('AI: Draft Prose').first().json;\nconst draft_text = r.content && r.content[0] ? String(r.content[0].text || '').trim() : '';\nif (!draft_text) throw new Error('Draft output is empty');\nreturn [{ json: { ...d, draft_text } }];"
      },
      "id": "step3-extract-draft-node",
      "name": "Extract Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6500,
        820
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $('Extract Draft').first().json;\nconst system = [\n  'You are a critique engine.',\n  'Do not rewrite.',\n  'Return JSON only with issue list and fix plan.'\n].join('\\n');\nconst user = [\n  'Draft:',\n  d.draft_text,\n  '',\n  'Return JSON:',\n  '{ issues:[{type,severity,location,description,fix_plan}], summary }'\n].join('\\n');\n\nreturn [{\n  json: {\n    ...d,\n    request_body: {\n      model: 'claude-sonnet-4-6',\n      max_tokens: 4096,\n      system,\n      messages: [{ role: 'user', content: user }]\n    }\n  }\n}];"
      },
      "id": "step3-build-critique-request-node",
      "name": "Build Critique Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6760,
        820
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
