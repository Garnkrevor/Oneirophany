        "jsCode": "const d = $('Build Critique Request').first().json;\nconst r = $('AI: Critique Only').first().json;\nconst raw = r.content && r.content[0] ? r.content[0].text : '';\nconst cleaned = String(raw).replace(/^```json\\s*/i, '').replace(/\\s*```$/i, '').trim();\nlet critique_report;\ntry { critique_report = JSON.parse(cleaned); }\ncatch (e) { throw new Error('Critique parse failed: ' + e.message); }\nreturn [{ json: { ...d, critique_report } }];"
      },
